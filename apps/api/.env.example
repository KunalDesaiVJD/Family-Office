# Family Wealth OS — backend (apps/api) environment template.
# Copy to `.env` for local development. NEVER commit real values.
# Broker API calls only ever happen from this backend, never the browser.

# --- Server ---
PORT=8080
NODE_ENV=development

# CORS: only this frontend origin is allowed (comma-separated for multiple).
FRONTEND_URL=http://localhost:3000

# --- Angel One SmartAPI (READ-ONLY) ---
# Real values are added at deploy time only, in the host's secret manager.
ANGEL_API_BASE_URL=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_READ_ONLY_MODE=true

# Optional: shared secret required to call the internal server-side session
# endpoint (POST /api/v1/broker/session). The browser must NEVER hold this.
# Leave blank to keep that endpoint disabled.
INTERNAL_API_KEY=

# NOTE: the broker login PIN/MPIN, OTP and TOTP secret are NEVER stored here or
# anywhere in this repo. They are supplied transiently to authenticate() from a
# secure vault at request time and immediately discarded.
