# Family Wealth OS — environment template
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. NEVER commit real values;
# `.env*` files are gitignored (only this `.env.example` is tracked).
#
# IMPORTANT: this foundation build uses MOCK DATA ONLY and reads NO environment
# variables at runtime. You can deploy to Vercel with ZERO env vars configured.
# The keys below are documentation-only placeholders for future integrations.
# ---------------------------------------------------------------------------

# =========================================================================
# PUBLIC — safe to expose to the browser.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the client bundle and is
# fully visible to end users. Put ONLY non-sensitive config here.
# =========================================================================
NEXT_PUBLIC_APP_NAME="Family Wealth OS"
NEXT_PUBLIC_DEFAULT_TENANT="vj-desai-family"
# Connector data source: "mock" (default) or "live" (live placeholders, not yet implemented).
NEXT_PUBLIC_DATA_SOURCE="mock"

# =========================================================================
# SERVER-ONLY — SECRET. Never prefix any of these with NEXT_PUBLIC_.
# These are read only on the server and must never reach the browser bundle.
# In production, set them in the Vercel dashboard (Project → Settings →
# Environment Variables), NOT in this file. Leave blank here.
#
# Not used yet — connectors/auth/DB/AI are out of scope for this build.
# =========================================================================

# Database (Prisma / PostgreSQL). Required only to run Prisma migrations, seed
# and live queries — the mock UI builds and runs WITHOUT it. Never commit a real
# value. Example: postgresql://USER:PASSWORD@HOST:5432/family_wealth_os?schema=public
DATABASE_URL=""

# Future: authentication provider (not connected yet)
AUTH_SECRET=""
AUTH_ISSUER_URL=""

# Future: connector integrations. Real broker/bank credentials must flow
# through a secure vault / connector service — NEVER through env vars or the
# frontend. These are only base URLs of a separate backend, if used.
BROKER_CONNECTOR_BASE_URL=""
TALLY_CONNECTOR_BASE_URL=""

# Future: AI Desk (server-side only — must stay secret)
ANTHROPIC_API_KEY=""
